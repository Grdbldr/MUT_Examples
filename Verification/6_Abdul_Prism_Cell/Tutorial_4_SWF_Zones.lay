#!MC 1410
$!SetStyleBase Factory
$!Page
  Name = 'Tutorial 4: SWF zones'
  PaperAttributes
    {
    BackgroundColor = White
    IsTransparent = No
    OrientPortrait = No
    ShowGrid = No
    ShowRuler = No
    ShowPaper = Yes
    PaperSize = Letter
    }
### Frame SWF Zone ###
$!VarSet |LFDSFN1| = '"STANDARDSYNTAX" "1.0" "FILELIST_DATAFILES" "1" "_buildo.Modflow.SWF.tecplot.szplt"'
$!ReadDataSet  '|LFDSFN1|'
  DataSetReader = 'Tecplot Subzone Data Loader'
  InitialPlotType = Cartesian3D
  AssignStrandIDs = Yes
$!RemoveVar |LFDSFN1|
$!VarSet |LFDSFN2| = '"CustomLabels_SWF.dat"'
$!ReadDataSet  '|LFDSFN2|'
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  InitialPlotType = Cartesian3D
  AssignStrandIDs = Yes
  ReadDataOption = Append
  VarLoadMode = ByName
$!RemoveVar |LFDSFN2|
$!FrameLayout
  ShowHeader = No
  IsTransparent = No
  XYPos
    {
    X = 0.25
    Y = 0.25
    }
  Width = 10.5
  Height = 4.0
$!PlotType = Cartesian3D
$!FrameName = 'SWF Zone'
$!ActiveFieldMaps = [1]
$!GlobalContour  1
  Var = 4
  ColorMapName = 'Small Rainbow'
  Labels
    {
    NumFormat
      {
        Formatting = CustomLabel
      }
    }
  Legend
    {
    Show = Yes
    AnchorAlignment = TopRight
    XYPos
      {
      X = 98
      Y = 95
      }
    AutoResize = Yes
    OverlayBarGrid = No
    Box
      {
      BoxType = Filled
      }
    HeaderTextShape
      {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 3
      }
    NumberTextShape
      {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 2.8
      }
    }
$!ContourLevels New
  ContourGroup = 1
  RawData
2
1
2
$!FieldMap  [1]
  Mesh
    {
    Show = Yes
    Color = Black
    LineThickness = 0.05
    }
  Contour
    {
    Show = Yes
    ContourType = Flood
    FloodColoring = Group1
    UseLightingEffect = Yes
    }
  Shade
    {
    Color = Custom2
    }
  Scatter
    {
    Show = No
    }
$!FieldLayers
  ShowContour = Yes
  ShowShade = Yes
  ShowMesh = Yes
  ShowScatter = No
  ShowEdge = No
  UseLightingEffect = Yes
$!ThreeDAxis
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
  FrameAxis
    {
    Show = Yes
    }
$!GlobalThreeD
  AxisScaleFact
    {
    X = 1
    Y = 1
    Z = 3
    }
$!ThreeDView
  PsiAngle = 45
  ThetaAngle = 240
  AlphaAngle = 0
$!View Fit
$!AttachText
  AnchorPos
    {
    X = 2
    Y = 94
    }
  TextShape
    {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 4.5
    }
  Box
    {
    BoxType = Filled
    Margin = 20
    }
  Anchor = Left
  Text = 'generate swf domain / chosen zones use swf material number'
$!AttachText
  AnchorPos
    {
    X = 2
    Y = 83
    }
  TextShape
    {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 3.8
    }
  Anchor = Left
  Text = 'Zone 1 Streambed: material 7, Manning n = 0.01'
$!AttachText
  AnchorPos
    {
    X = 2
    Y = 75
    }
  TextShape
    {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 3.8
    }
  Anchor = Left
  Text = 'Zone 2 Grass: material 4, Manning n = 0.3'
### Frame SWF Initial Depth ###
$!CreateNewFrame
$!VarSet |LFDSFN1| = '"STANDARDSYNTAX" "1.0" "FILELIST_DATAFILES" "1" "_buildo.Modflow.SWF.tecplot.szplt"'
$!ReadDataSet  '|LFDSFN1|'
  DataSetReader = 'Tecplot Subzone Data Loader'
  InitialPlotType = Cartesian3D
  AssignStrandIDs = Yes
$!RemoveVar |LFDSFN1|
$!FrameLayout
  ShowHeader = No
  IsTransparent = No
  XYPos
    {
    X = 0.25
    Y = 4.3
    }
  Width = 10.5
  Height = 4.0
$!PlotType = Cartesian3D
$!FrameName = 'SWF Initial Depth'
$!ActiveFieldMaps = [1]
$!GlobalContour  1
  Var = 7
  ColorMapName = 'Sequential - Viridis'
  Labels
    {
    NumFormat
      {
        Formatting = Exponential
        Precision = 2
      }
    }
  Legend
    {
    Show = Yes
    AnchorAlignment = TopRight
    XYPos
      {
      X = 98
      Y = 95
      }
    AutoResize = Yes
    OverlayBarGrid = No
    Box
      {
      BoxType = Filled
      }
    HeaderTextShape
      {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 3
      }
    NumberTextShape
      {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 2.8
      }
    }
$!ContourLevels New
  ContourGroup = 1
  RawData
4
5e-05
8e-05
0.00012
0.00015
$!FieldMap  [1]
  Mesh
    {
    Show = No
    Color = Black
    LineThickness = 0.05
    }
  Contour
    {
    Show = Yes
    ContourType = Flood
    FloodColoring = Group1
    UseLightingEffect = Yes
    }
  Shade
    {
    Color = Custom2
    }
  Scatter
    {
    Show = No
    }
$!FieldLayers
  ShowContour = Yes
  ShowShade = Yes
  ShowMesh = No
  ShowScatter = No
  ShowEdge = No
  UseLightingEffect = Yes
$!ThreeDAxis
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
  FrameAxis
    {
    Show = Yes
    }
$!GlobalThreeD
  AxisScaleFact
    {
    X = 1
    Y = 1
    Z = 3
    }
$!ThreeDView
  PsiAngle = 45
  ThetaAngle = 240
  AlphaAngle = 0
$!View Fit
$!AttachText
  AnchorPos
    {
    X = 2
    Y = 94
    }
  TextShape
    {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 4.5
    }
  Box
    {
    BoxType = Filled
    Margin = 20
    }
  Anchor = Left
  Text = 'swf initial depth 1.0e-4 m (all cells)'
$!FrameControl ActivateByNumber
  Frame = 1
