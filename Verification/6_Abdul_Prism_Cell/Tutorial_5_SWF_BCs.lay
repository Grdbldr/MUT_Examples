#!MC 1410
$!SetStyleBase Factory
$!Page
  Name = 'Tutorial 5: SWF boundary conditions'
  PaperAttributes
    {
    BackgroundColor = White
    IsTransparent = No
    OrientPortrait = No
    ShowGrid = No
    ShowRuler = No
    ShowPaper = Yes
    PaperSize = Letter
    }
### Frame SWF recharge ###
$!VarSet |LFDSFN1| = '"STANDARDSYNTAX" "1.0" "FILELIST_DATAFILES" "1" "_buildo.Modflow.SWF.tecplot.szplt"'
$!ReadDataSet  '|LFDSFN1|'
  DataSetReader = 'Tecplot Subzone Data Loader'
  InitialPlotType = Cartesian3D
  AssignStrandIDs = Yes
$!RemoveVar |LFDSFN1|
$!VarSet |LFDSFN2| = '"_posto.modflow.SWF_RCH.tecplot.dat"'
$!ReadDataSet  '|LFDSFN2|'
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  InitialPlotType = Cartesian3D
  AssignStrandIDs = Yes
  ReadDataOption = Append
  VarLoadMode = ByName
$!RemoveVar |LFDSFN2|
$!VarSet |LFDSFN3| = '"_buildo.Modflow.SWF_SWBC.tecplot.dat"'
$!ReadDataSet  '|LFDSFN3|'
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  InitialPlotType = Cartesian3D
  AssignStrandIDs = Yes
  ReadDataOption = Append
  VarLoadMode = ByName
$!RemoveVar |LFDSFN3|
$!FrameLayout
  ShowHeader = No
  IsTransparent = No
  XYPos
    {
    X = 0.25
    Y = 0.25
    }
  Width = 10.5
  Height = 4.0
$!PlotType = Cartesian3D
$!FrameName = 'SWF recharge'
$!ActiveFieldMaps = [1-3]
$!FieldMap  [1]
  Mesh
    {
    Show = Yes
    Color = Black
    LineThickness = 0.05
    }
  Contour
    {
    Show = No
    ContourType = Flood
    FloodColoring = Group1
    UseLightingEffect = Yes
    }
  Shade
    {
    Color = White
    }
  Scatter
    {
    Show = No
    }
$!FieldMap  [2]
  Mesh
    {
    Show = No
    }
  Contour
    {
    Show = No
    }
  Shade
    {
    Show = No
    }
  Scatter
    {
    Show = Yes
    Color = Blue
    FillMode = UseSpecificColor
    FillColor = Blue
    SymbolShape
      {
      GeomShape = Circle
      }
    FrameSize = 0.35
    }
$!FieldMap  [3]
  Mesh
    {
    Show = No
    }
  Contour
    {
    Show = No
    }
  Shade
    {
    Show = No
    }
  Scatter
    {
    Show = Yes
    Color = Red
    FillMode = UseSpecificColor
    FillColor = Red
    SymbolShape
      {
      GeomShape = Circle
      }
    FrameSize = 3
    }
$!FieldLayers
  ShowContour = No
  ShowShade = Yes
  ShowMesh = Yes
  ShowScatter = Yes
  ShowEdge = No
  UseLightingEffect = Yes
$!ThreeDAxis
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
  FrameAxis
    {
    Show = Yes
    }
$!GlobalThreeD
  AxisScaleFact
    {
    X = 1
    Y = 1
    Z = 3
    }
$!ThreeDView
  PsiAngle = 45
  ThetaAngle = 240
  AlphaAngle = 0
$!View Fit
$!AttachText
  AnchorPos
    {
    X = 2
    Y = 94
    }
  TextShape
    {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 4
    }
  Box
    {
    BoxType = Filled
    Margin = 20
    }
  Anchor = Left
  Text = 'swf recharge 5.56e-6 m/s (option 4) on all SWF cells in stress period 1'
$!AttachText
  AnchorPos
    {
    X = 2
    Y = 84
    }
  TextShape
    {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 3.8
    }
  Anchor = Left
  Text = 'Blue: recharge cells     Red: swf critical depth outlet cells'
### Frame SWF critical depth ###
$!CreateNewFrame
$!VarSet |LFDSFN1| = '"STANDARDSYNTAX" "1.0" "FILELIST_DATAFILES" "1" "_buildo.Modflow.SWF.tecplot.szplt"'
$!ReadDataSet  '|LFDSFN1|'
  DataSetReader = 'Tecplot Subzone Data Loader'
  InitialPlotType = Cartesian2D
  AssignStrandIDs = Yes
$!RemoveVar |LFDSFN1|
$!VarSet |LFDSFN2| = '"_posto.modflow.SWF_RCH.tecplot.dat"'
$!ReadDataSet  '|LFDSFN2|'
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  InitialPlotType = Cartesian2D
  AssignStrandIDs = Yes
  ReadDataOption = Append
  VarLoadMode = ByName
$!RemoveVar |LFDSFN2|
$!VarSet |LFDSFN3| = '"_buildo.Modflow.SWF_SWBC.tecplot.dat"'
$!ReadDataSet  '|LFDSFN3|'
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  InitialPlotType = Cartesian2D
  AssignStrandIDs = Yes
  ReadDataOption = Append
  VarLoadMode = ByName
$!RemoveVar |LFDSFN3|
$!FrameLayout
  ShowHeader = No
  IsTransparent = No
  XYPos
    {
    X = 0.25
    Y = 4.3
    }
  Width = 10.5
  Height = 4.0
$!PlotType = Cartesian2D
$!FrameName = 'SWF critical depth'
$!ActiveFieldMaps = [1-3]
$!FieldMap  [1]
  Mesh
    {
    Show = Yes
    Color = Black
    LineThickness = 0.05
    }
  Contour
    {
    Show = No
    ContourType = Flood
    FloodColoring = Group1
    UseLightingEffect = Yes
    }
  Shade
    {
    Color = White
    }
  Scatter
    {
    Show = No
    }
$!FieldMap  [2]
  Mesh
    {
    Show = No
    }
  Contour
    {
    Show = No
    }
  Shade
    {
    Show = No
    }
  Scatter
    {
    Show = Yes
    Color = Blue
    FillMode = UseSpecificColor
    FillColor = Blue
    SymbolShape
      {
      GeomShape = Circle
      }
    FrameSize = 0.6
    }
$!FieldMap  [3]
  Mesh
    {
    Show = No
    }
  Contour
    {
    Show = No
    }
  Shade
    {
    Show = No
    }
  Scatter
    {
    Show = Yes
    Color = Red
    FillMode = UseSpecificColor
    FillColor = Red
    SymbolShape
      {
      GeomShape = Circle
      }
    FrameSize = 3
    }
$!FieldLayers
  ShowContour = No
  ShowShade = Yes
  ShowMesh = Yes
  ShowScatter = Yes
  ShowEdge = No
  UseLightingEffect = Yes
$!TwoDAxis
  AxisMode = XYDependent
  DepXToYRatio = 1
  XDetail
    {
    RangeMin = 60
    RangeMax = 76
    }
  YDetail
    {
    RangeMin = -1
    RangeMax = 7
    }
$!AttachText
  AnchorPos
    {
    X = 2
    Y = 94
    }
  TextShape
    {
      FontFamily = 'Helvetica'
      IsBold = Yes
      SizeUnits = Frame
      Height = 4
    }
  Box
    {
    BoxType = Filled
    Margin = 20
    }
  Anchor = Left
  Text = 'swf critical depth: cells chosen from gb elements (Critical depth outlet)'
$!FrameControl ActivateByNumber
  Frame = 1
